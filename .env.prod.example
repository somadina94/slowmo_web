# =============================================================================
# Slow Mo Web — production env (server `.env` for compose + GHCR pull)
# =============================================================================
#
# VITE_API_BASE_URL is applied at CONTAINER START (written to /env.js).
# Keep this set on the server — it overrides whatever was baked into the image.
#
# Optional: also set the same value as a GitHub Actions Variable for CI builds.
#
# GHCR (server pulls of private images):
#   GHCR_USERNAME=your-github-username
#   GHCR_TOKEN=ghp_xxx   # PAT with read:packages
# =============================================================================

VITE_API_BASE_URL=https://api.slowmo.jahbyte.com/api/v1
VITE_RAZORPAY_KEY_ID=rzp_live_replace
VITE_APP_ENV=prod

WEB_PORT=5011
SLOWMO_WEB_IMAGE=ghcr.io/OWNER/slowmo-web:latest
GHCR_USERNAME=
GHCR_TOKEN=
DEPLOY_BUILD_LOCAL=0
