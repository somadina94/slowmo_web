# =============================================================================
# Slow Mo Web — production env (server `.env` for compose + GHCR pull)
# =============================================================================
#
# Vite vars below are baked into the image at CI build time via the
# GitHub Actions Variable VITE_API_BASE_URL (not this file on the server).
# On the server they mainly document / support local rebuilds.
#
# Set in GitHub → Settings → Variables:
#   VITE_API_BASE_URL=https://api.slowmo.jahbyte.com/api/v1
#
# GHCR:
#   Optional for CI (uses GITHUB_TOKEN). For manual server pulls, set:
#   GHCR_USERNAME=your-github-username
#   GHCR_TOKEN=ghp_xxx   # PAT with read:packages
# =============================================================================

VITE_API_BASE_URL=https://api.slowmo.jahbyte.com/api/v1
VITE_RAZORPAY_KEY_ID=rzp_live_replace
VITE_APP_ENV=prod

WEB_PORT=5011
SLOWMO_WEB_IMAGE=ghcr.io/OWNER/slowmo-web:latest
GHCR_USERNAME=
GHCR_TOKEN=
DEPLOY_BUILD_LOCAL=0
